<?xml version="1.0" encoding="UTF-8"?>
<!--
  Auto-start the Capture stack on the Mac Mini at boot/login.

  Install:
    1. Edit WorkingDirectory below to your checkout path.
    2. cp infra/selfhost/dev.crmitchelmore.capture.plist ~/Library/LaunchAgents/
    3. launchctl load -w ~/Library/LaunchAgents/dev.crmitchelmore.capture.plist

  This runs `docker compose up` (foreground) so launchd supervises it and restarts
  on crash. Compose's own `restart: unless-stopped` handles per-container restarts.
  Logs go to /tmp/capture-stack.{out,err}.log.

  Requires Docker/OrbStack to be running. If you use OrbStack, ensure it is set to
  start at login (OrbStack > Settings > Start at login) so the socket exists.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.crmitchelmore.capture</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>exec docker compose up</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/REPLACE_ME/work/todo</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/capture-stack.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/capture-stack.err.log</string>
</dict>
</plist>
