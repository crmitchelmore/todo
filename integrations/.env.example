# Obsidian Local REST API plugin
# Use the HTTPS endpoint shown in Settings → Local REST API, commonly https://127.0.0.1:27124
OBSIDIAN_API_URL=https://127.0.0.1:27124
OBSIDIAN_API_KEY=your-obsidian-api-key-here

# Gmail API OAuth2 read-only access
# Scope: https://www.googleapis.com/auth/gmail.readonly
GMAIL_CLIENT_ID=your-gmail-client-id-here
GMAIL_CLIENT_SECRET=your-gmail-client-secret-here
GMAIL_REFRESH_TOKEN=your-gmail-refresh-token-here
