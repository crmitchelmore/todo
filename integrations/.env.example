# Obsidian Local REST API plugin
# Use the HTTPS endpoint shown in Settings → Local REST API, commonly https://127.0.0.1:27124
OBSIDIAN_API_URL=https://127.0.0.1:27124
OBSIDIAN_API_KEY=your-obsidian-api-key-here

# Gmail read-only access via IMAP + App Password (no OAuth client to maintain)
GMAIL_IMAP_USER=you@gmail.com
GMAIL_IMAP_APP_PASSWORD=your-16-char-app-password
# Optional overrides (defaults shown)
# GMAIL_IMAP_HOST=imap.gmail.com
# GMAIL_IMAP_PORT=993
