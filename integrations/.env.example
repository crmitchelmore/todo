# Obsidian Local REST API plugin
# Use HTTPS if the plugin certificate is trusted; otherwise use loopback HTTP if enabled.
OBSIDIAN_API_URL=http://127.0.0.1:27123
OBSIDIAN_API_KEY=placeholder

# Gmail read-only access via IMAP + App Password (no OAuth client to maintain)
GMAIL_IMAP_USER=you@gmail.com
GMAIL_IMAP_APP_PASSWORD=placeholder
# Optional overrides (defaults shown)
# GMAIL_IMAP_HOST=imap.gmail.com
# GMAIL_IMAP_PORT=993

# Real values belong in ignored integrations/.env.local or in macOS Keychain service "capture".
# Example keychain account names: OBSIDIAN_API_KEY, GMAIL_IMAP_APP_PASSWORD.
