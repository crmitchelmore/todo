{
  "name": "capture-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3030 --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 3030",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "test:ui": "playwright test",
    "validate:ui": "npm run build && playwright test"
  },
  "dependencies": {
    "@powersync/react": "^2.0.2",
    "@powersync/web": "^2.4.2",
    "@sentry/react": "^10.57.0",
    "@simplewebauthn/browser": "^13.3.0",
    "chrono-node": "^2.7.7",
    "js-logger": "^1.6.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
