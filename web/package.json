{
  "name": "capture-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3030 --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 3030",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "test:ui": "playwright test",
    "validate:ui": "npm run build && playwright test"
  },
  "dependencies": {
    "@powersync/react": "^1.5.3",
    "@powersync/web": "^1.20.0",
    "@sentry/react": "^10.57.0",
    "@simplewebauthn/browser": "^13.3.0",
    "chrono-node": "^2.7.7",
    "js-logger": "^1.6.1",
    "react": "^19.3.0",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vite": "^6.4.3"
  }
}
