# Local dev (docker-compose stack):
# VITE_BACKEND_URL=http://localhost:6060
# VITE_POWERSYNC_URL=http://localhost:8080

# Railway production deployment:
VITE_BACKEND_URL=https://backend-production-de2f.up.railway.app
VITE_POWERSYNC_URL=https://powersync-production-e560.up.railway.app

# Sign in with Apple (web). Requires an Apple Services ID and a verified HTTPS domain + return URL
# registered in the Apple Developer portal — so the web sign-in only works once hosted on a real
# domain, not from a local vite dev origin.
VITE_APPLE_SERVICES_ID=dev.crmitchelmore.capture.web
# Defaults to window.location.origin when unset.
# VITE_APPLE_REDIRECT_URI=https://capture.example.com
