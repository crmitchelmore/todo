# Capture web — production endpoints are baked into the bundle (see src/config.ts),
# so no env is required to build/host. Override only for local/preview targets.

# Local dev (docker-compose stack):
# VITE_BACKEND_URL=http://localhost:6060
# VITE_POWERSYNC_URL=http://localhost:8080

# Mac mini production (defaults baked in; set only to override):
# VITE_BACKEND_URL=https://bravos-mac-mini.taile313a5.ts.net:10000
# VITE_POWERSYNC_URL=https://bravos-mac-mini.taile313a5.ts.net:10000
