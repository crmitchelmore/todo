# Copy to `.env.acceptance` (gitignored) and fill in. NEVER commit real secrets.

# ==== use.computer sandbox driver (SECRET) ====
# Get a key from https://use.computer — used to drive macOS/iOS sandboxes.
USE_COMPUTER_API_KEY=uc_live_...

# ==== Target environment ====
# Production Railway is the default (what the shipped apps point at).
CAPTURE_WEB_URL=https://web-production-9267a.up.railway.app
CAPTURE_BACKEND_URL=https://backend-production-de2f.up.railway.app
CAPTURE_POWERSYNC_URL=https://powersync-production-e560.up.railway.app
# For a local docker stack instead:
#   CAPTURE_WEB_URL=http://localhost:3030
#   CAPTURE_BACKEND_URL=http://localhost:6060
#   CAPTURE_POWERSYNC_URL=http://localhost:8080

# ==== Dedicated throwaway test account ====
# Registered via email+password (no email verification). Leave blank to have the
# harness generate and persist a stable account into your local .env.acceptance.
ACCEPTANCE_ACCOUNT_EMAIL=
ACCEPTANCE_ACCOUNT_PASSWORD=

# ==== Model credentials for the app LLM config + LLM-as-judge evals (OPTIONAL) ====
# When unset, LLM-gated acceptance tests and evals are SKIPPED (not failed).
# Any OpenAI-compatible endpoint exposing POST {BASE_URL}/chat/completions works.
ACCEPTANCE_LLM_API_KEY=
ACCEPTANCE_LLM_BASE_URL=https://api.openai.com/v1
ACCEPTANCE_LLM_MODEL=gpt-4o-mini
