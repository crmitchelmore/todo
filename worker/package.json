{
  "name": "capture-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Background enrichment worker: upgrades on-device suggestions for proposed tasks. Never changes status (confirm-before-save).",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "once": "ENRICH_RUN_ONCE=1 tsx src/index.ts",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@sentry/node": "^11.6.0",
    "chrono-node": "^2.10.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
