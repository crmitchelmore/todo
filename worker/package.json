{
  "name": "capture-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Background enrichment worker: upgrades on-device suggestions for proposed tasks. Never changes status (confirm-before-save).",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "once": "ENRICH_RUN_ONCE=1 tsx src/index.ts",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "chrono-node": "^2.7.7",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
