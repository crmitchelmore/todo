# ==================== Postgres ====================
PG_DATABASE_NAME=postgres
PG_DATABASE_PORT=5432
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=local-dev-password
PS_DATA_SOURCE_URI=postgres://postgres:local-dev-password@pg-db:5432/postgres

# ==================== PowerSync service ====================
PS_PORT=8080
# Bucket storage now uses Postgres (separate `powersync` db on the same server) — no Mongo.
PS_STORAGE_URI=postgres://postgres:local-dev-password@pg-db:5432/powersync
PS_JWKS_URL=http://backend:6060/api/auth/keys

# ==================== Backend connector ====================
BACKEND_PORT=6060
BACKEND_DATABASE_URI=postgres://postgres:local-dev-password@pg-db:5432/postgres
JWT_ISSUER=capture-dev
JWT_AUDIENCE=powersync-dev
# Dev user the single-user M1 slice operates as.
DEV_USER_ID=00000000-0000-0000-0000-000000000001
# Shared-secret gate for /api/auth/token, /api/capture, /api/data. Leave UNSET for local dev
# (backend runs open). REQUIRED in production (the backend refuses to boot without it). Clients
# must send `Authorization: Bearer <value>`.
CAPTURE_API_SECRET=
PUBLIC_WEB_ORIGIN=http://localhost:3030
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Capture

# GitHub OAuth (optional). Set the secret in Railway/GitHub secrets, never in a tracked file.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Optional separate HMAC key for OAuth state; defaults to GITHUB_OAUTH_CLIENT_SECRET.
OAUTH_STATE_SECRET=

# ==================== Auth email (production) ====================
# Force a provider or leave blank to auto-detect the first configured credential below.
# Supported: smtp, resend, brevo, sendgrid, postmark.
MAIL_PROVIDER=
MAIL_FROM="Capture <onboarding@resend.dev>"
# SMTP is the broadest escape hatch (works with any relay provider).
SMTP_URL=
# HTTP providers (set exactly one in production unless MAIL_PROVIDER forces a choice).
RESEND_API_KEY=
BREVO_API_KEY=
SENDGRID_API_KEY=
POSTMARK_SERVER_TOKEN=

# ==================== PowerSync admin API ====================
# Token guarding the PowerSync management API. Set to a strong random value in production.
PS_API_TOKEN=placeholder

# ==================== Optional local-only secrets ====================
# Keep real secrets out of tracked files. Put them in ignored .env.local files or store them in
# the macOS Keychain under service "capture" with the account name equal to the env var, then run
# commands through scripts/with-secrets.sh.
# RAILWAY_API_TOKEN=
# OPENAI_API_KEY=
# Optional for a local/Mac worker: scan Git remotes under this root to associate
# engineering tasks with GitHub repos. On macOS the worker falls back to ~/work.
# CAPTURE_WORK_ROOT=/Users/you/work
# CAPTURE_WORK_ROOT_MAX_REPOS=200
# OBSIDIAN_API_URL=http://127.0.0.1:27123
# OBSIDIAN_API_KEY=
# GMAIL_IMAP_USER=
# GMAIL_IMAP_APP_PASSWORD=
# OpenClaw execution is disabled unless explicitly enabled and fully configured.
# The private key must stay outside the repo; share only the matching public key with the Mac Mini.
# OPENCLAW_EXECUTOR_ENABLED=0
# OPENCLAW_SSH_HOST=bravos-mac-mini.taile313a5.ts.net
# OPENCLAW_SSH_USER=bravostation
# OPENCLAW_SSH_KEY_PATH=/Users/you/.ssh/capture_openclaw_ed25519
# OPENCLAW_WORKDIR=/Users/bravostation/clawd
# OPENCLAW_CLI=/opt/homebrew/bin/openclaw
# OPENCLAW_AGENT=imessage-agent
# OPENCLAW_TIMEOUT_SECONDS=120
# OPENCLAW_THINKING=medium
# OPENCLAW_REMOTE_PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
# GITHUB_OAUTH_CLIENT_SECRET=

# ==================== Web client (host dev) ====================
# Used by Vite (web/.env is generated from these by `npm run dev`).
VITE_POWERSYNC_URL=http://localhost:8080
VITE_BACKEND_URL=http://localhost:6060
